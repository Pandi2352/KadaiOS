PORT=8000
MONGODB_URI=mongodb://localhost:27017/kadai_os
# Use * to allow every origin, or a comma-separated list of addresses.
# The frontends reach the API through the Vite proxy in development, so login cookies work with *.
# List the addresses if a frontend calls the API directly from another origin.
CLIENT_ORIGINS=*
# Set to production to turn off the Swagger docs and turn on the strict security policy.
NODE_ENV=development

# Required. Create a value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Login and register attempts allowed per minute, per address.
AUTH_RATE_LIMIT=10

# Created when the API starts, if they don't exist yet. Changing these won't change an existing user.
# Change the admin password before any real use. Production refuses this example password.
DEFAULT_ADMIN_NAME=Default Admin
DEFAULT_ADMIN_EMAIL=admin@kadaios.test
DEFAULT_ADMIN_PASSWORD=Admin@12345

# For login testing on the customer site. Never created in production.
DEFAULT_CUSTOMER_NAME=Test Customer
DEFAULT_CUSTOMER_EMAIL=customer@kadaios.test
DEFAULT_CUSTOMER_PASSWORD=Customer@12345

# SMTP configuration for email delivery (admin invites, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KadaiOS <no-reply@kadaios.test>

# URL of the admin site for invitation links
ADMIN_APP_URL=http://localhost:3000

